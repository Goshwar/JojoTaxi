# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# The Netlify build hook behind the admin "Publish" button is deliberately NOT
# here: every VITE_ variable is inlined into the client bundle, and that URL is
# enough on its own to spend the site's build minutes. It lives as the
# NETLIFY_BUILD_HOOK secret on the `publish-site` Supabase Edge Function
# instead (Supabase → Edge Functions → Secrets).

# n8n automation webhooks
VITE_N8N_WEBHOOK_URL=https://n8n-ukuk.onrender.com/webhook/ftt-new-booking
VITE_N8N_STATUS_WEBHOOK_URL=https://n8n-ukuk.onrender.com/webhook/ftt-booking-status
