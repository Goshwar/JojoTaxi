# Supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Netlify build hook (optional).
# Enables the "Publish" button on /admin/rates, which rebuilds the site so the
# prerendered HTML and llms.txt catch up with a price change. Without it, price
# edits still reach visitors immediately but crawlers see the last deploy.
VITE_NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/<hook-id>

# n8n automation webhooks
VITE_N8N_WEBHOOK_URL=https://n8n-ukuk.onrender.com/webhook/ftt-new-booking
VITE_N8N_STATUS_WEBHOOK_URL=https://n8n-ukuk.onrender.com/webhook/ftt-booking-status
